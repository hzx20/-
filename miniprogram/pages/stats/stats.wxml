<!--
  miniprogram/pages/stats/stats.wxml —— 学习数据页

  【页面结构】
  1. 四个核心数字：今日 / 累计 / 正确率 / 连续打卡
  2. 最近 7 天柱状图：纯 WXML + CSS 实现，不用 canvas
  3. 模块正确率排行：从低到高，最弱的在最上面
  4. 云端数据：只在请求成功时渲染，失败整块消失

  【柱状图的实现原理，见 stats.wxss 的注释】
-->
<view class="container">

  <!-- ============ 核心数字 ============ -->
  <!--
    【为什么用四个而不是一个】
    单看正确率没有意义，用户不知道自己练了多少。
    "今日 + 累计 + 正确率 + 连续天数"合起来才构成完整的努力画像：
    今天做了（当下）、一共做了（总量）、做得好不好（质量）、能不能坚持（习惯）。
  -->
  <view class="card">
    <view class="grid-4">
      <view class="grid-cell">
        <view class="grid-num text-primary">{{todayCount}}</view>
        <view class="text-muted">今日题量</view>
      </view>
      <view class="grid-cell">
        <view class="grid-num">{{totalDone}}</view>
        <view class="text-muted">累计题量</view>
      </view>
      <view class="grid-cell">
        <view class="grid-num {{accuracy < 60 ? 'text-danger' : 'text-success'}}">{{accuracy}}%</view>
        <view class="text-muted">总正确率</view>
      </view>
      <view class="grid-cell">
        <view class="grid-num {{streakDays > 0 ? 'text-primary' : ''}}">{{streakDays}}</view>
        <view class="text-muted">连续天数</view>
      </view>
    </view>
    <view class="text-muted" style="margin-top:20rpx;">
      题库共 {{totalAll}} 题，已完成 {{totalDone}} 题，进度 {{overallPercent}}%
    </view>
    <view class="progress-bar" style="margin-top:12rpx;">
      <view class="progress-inner" style="width:{{overallPercent}}%;"></view>
    </view>
  </view>

  <!-- ============ 最近 7 天柱状图 ============ -->
  <!--
    【纯 CSS 柱状图的做法】
    一行 flex 排 7 列，每列底部对齐（justify-content: flex-end），
    列高固定 200rpx，里面的竖条用 height:XX% 撑开，
    XX 由 JS 按"这天题数 / 最高天数题数 × 100"算好。

    【为什么不用 canvas】
    canvas 要引组件、处理 touch 事件、手算坐标，
    代码量大且在低端机上容易掉帧。
    这个图是纯展示，flex 完全够用，还能自动适配屏幕宽度。
  -->
  <view class="card">
    <view class="row-between" style="margin-bottom:24rpx;">
      <view class="title">最近 7 天</view>
      <text class="text-muted">{{activeDays}} 天有练习</text>
    </view>

    <view class="chart">
      <view
        wx:for="{{chart}}"
        wx:key="label"
        class="chart-col"
        bindtap="onTapBar"
        data-index="{{index}}"
      >
        <!-- 柱子上面显示具体题量，0 题时留空避免全是 0 显得杂乱 -->
        <view class="chart-count">{{item.count ? item.count : ''}}</view>
        <view class="chart-track">
          <view
            class="chart-bar {{item.isToday ? 'today' : ''}}"
            style="height:{{item.percent}}%;"
          ></view>
        </view>
        <view class="chart-label {{item.isToday ? 'today' : ''}}">{{item.label}}</view>
      </view>
    </view>
  </view>

  <!-- ============ 模块正确率 ============ -->
  <view class="card">
    <view class="title" style="margin-bottom:8rpx;">模块掌握情况</view>
    <view class="text-muted" style="margin-bottom:20rpx;">
      按正确率从低到高排列，红色表示需要重点攻克
    </view>

    <!-- 一题都没做的模块不显示，这里只有已练习过的模块 -->
    <view
      wx:for="{{moduleList}}"
      wx:key="key"
      class="mod-row"
      bindtap="onTapModule"
      data-module="{{item.key}}"
    >
      <view class="flex-1">
        <view class="row-between">
          <text class="mod-name">{{item.name}}</text>
          <text class="mod-accuracy {{item.low ? 'text-danger' : 'text-success'}}">
            {{item.accuracy}}%
          </text>
        </view>
        <view class="progress-bar" style="margin-top:12rpx;">
          <!-- 正确率低于 60% 的进度条也换成红色，视觉上和数字呼应 -->
          <view
            class="progress-inner {{item.low ? 'low' : ''}}"
            style="width:{{item.percent}}%;"
          ></view>
        </view>
        <view class="text-muted" style="margin-top:8rpx;">
          已练 {{item.done}} / {{item.total}} 题
        </view>
      </view>
    </view>

    <!-- 一个模块都没练过时显示引导，而不是空白 -->
    <view wx:if="{{moduleList.length === 0}}" class="text-muted" style="padding:24rpx 0;">
      还没有练习记录，做完一组题后这里会显示各模块的正确率。
    </view>
  </view>

  <!-- ============ 云端数据 ============ -->
  <!--
    【为什么失败时整块不渲染，而不是显示"加载失败"】
    cloudStats 只在 fetchStats 成功且有数据时才被赋值。
    弱网、没开通云开发、云函数没部署，都会让它保持 null。
    对用户来说云端数据可有可无，报错只会让他误以为本地数据也丢了，
    制造不必要的焦虑。所以这里什么都不显示。
  -->
  <view wx:if="{{cloudStats}}" class="card">
    <view class="row-between" style="margin-bottom:16rpx;">
      <view class="title">云端备份</view>
      <text class="tag tag-green">已同步</text>
    </view>
    <view class="row-between">
      <view class="text-muted">云端记录题数</view>
      <view class="text-muted">{{cloudStats.total}} 题</view>
    </view>
    <view class="row-between" style="margin-top:12rpx;">
      <view class="text-muted">云端正确题数</view>
      <view class="text-muted">{{cloudStats.correct}} 题</view>
    </view>
    <view class="text-muted" style="margin-top:20rpx;">
      云端数据用于换手机后恢复进度，本页统计以本机记录为准。
    </view>
  </view>

  <view class="footer-space"></view>
</view>