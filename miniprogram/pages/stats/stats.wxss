/* 学习数据页样式 */

/* ============ 顶部四宫格数字 ============ */
.grid-4 {
  display: flex;
  flex-direction: row;
}

.grid-cell {
  /* 【为什么用 flex:1 平分】四个数字等宽，视觉整齐，不会有一个特别宽 */
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.grid-num {
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.3;
  font-family: 'DIN Alternate', -apple-system, sans-serif;
}

/* ============ 7 天柱状图 ============ */
/*
  【实现原理，务必看懂这一段】
  整张图是一个横向 flex 容器，排 7 列。
  每列（.chart-col）分三部分，上下排列：
    1. .chart-count  柱子上方的数字（显示当天做了几题）
    2. .chart-track 柱子的"轨道"，高度固定 200rpx
    3. .chart-label 底部的日期文字

  关键在 .chart-track：
    - 高度固定 200rpx（相当于 JS 里的 CHART_MAX_HEIGHT）
    - 子元素 .chart-bar 用 height:XX% 撑开，
      而 XX 由 JS 按"这天题数 / 最高天数题数 × 100"算好
    - 用 flex + align-items:flex-end 让短柱子贴着底部生长，
      这样 3 题和 30 题的柱子都是从底部往上长，视觉上才成立
*/
.chart {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
}

.chart-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.chart-count {
  font-size: 20rpx;
  color: #6B7280;
  height: 28rpx;
  /* 【为什么要写死高度】不写的话，
     今天做了 0 题时这一行是空的，整根柱子会往上跳，
     七根柱子的底部就对不齐了。固定高度保证所有柱子基线一致。 */
  line-height: 28rpx;
}

/* 轨道：柱子的生长容器，高度即图表最大高度 */
.chart-track {
  width: 28rpx;
  height: 200rpx;
  /* 把柱子压在轨道底部，靠底对齐的柱子才会紧贴基线 */
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  background: #F4F6FB;
  border-radius: 8rpx;
}

.chart-bar {
  width: 100%;
  /* 高度由 JS 计算后通过 style 内联设置，这里只给保底值 */
  min-height: 6rpx;
  background: linear-gradient(180deg, #4B8BFF 0%, #1F5EFF 100%);
  border-radius: 8rpx;
  /* 【加个过渡】刷新数据时柱子平滑长高，比突然跳一下好看 */
  transition: height 0.3s ease;
}

/* 今天的那根用橙色，和其他天区分开 */
.chart-bar.today {
  background: linear-gradient(180deg, #FFC44D 0%, #FF8A00 100%);
}

.chart-label {
  font-size: 20rpx;
  color: #9AA1AE;
  margin-top: 12rpx;
  /* 日期形如 10/6，斜杠在窄屏可能换行，强制不换行 */
  white-space: nowrap;
}

.chart-label.today {
  color: #FF8A00;
  font-weight: 600;
}

/* ============ 模块正确率行 ============ */
.mod-row {
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F0F2F6;
}

.mod-row:last-child {
  border-bottom: none;
}

.mod-name {
  font-size: 30rpx;
  font-weight: 500;
}

.mod-accuracy {
  font-size: 30rpx;
  font-weight: 700;
  font-family: 'DIN Alternate', -apple-system, sans-serif;
}

/* 正确率低于 60% 的进度条换成红色，和数字颜色呼应 */
.progress-inner.low {
  background: linear-gradient(90deg, #F04438 0%, #FF7A70 100%);
}