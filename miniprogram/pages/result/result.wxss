/* 结果页样式 */
/* 说明：app.wxss 里已定义通用类（card / btn / tag 等），这里只写本页独有的 */

/* ============ 正确率大数字 ============ */
.score-card {
  text-align: center;
  padding: 48rpx 28rpx;
}

.score-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: center;
}

.score-num {
  /* 【为什么用 120rpx】约占屏幕宽度的 1/3，足够醒目又不至于撑破卡片 */
  font-size: 120rpx;
  font-weight: 700;
  line-height: 1;
  font-family: 'DIN Alternate', -apple-system, sans-serif;
}

/* 参数缺失时的占位符，用浅灰避免误导成"考了 0 分" */
.score-none {
  color: #D6DBE5;
}

.score-unit {
  font-size: 44rpx;
  font-weight: 600;
  color: #9AA1AE;
  margin-left: 8rpx;
}

.score-line {
  font-size: 26rpx;
  color: #6B7280;
  margin-top: 12rpx;
}

/* ============ 评价标签 ============ */
/*
  【四档配色】
  lv4 绿（很扎实）/ lv3 蓝（不错）/ lv2 橙（刚及格）/ lv1 红（需加强）
  用同一套 class 同时控制数字颜色和标签底色，保证视觉统一。
*/
.comment-badge {
  display: inline-flex;
  margin-top: 24rpx;
  padding: 10rpx 32rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.comment-badge.lv4,
.score-num.lv4 {
  color: #12B76A;
}

.comment-badge.lv4 {
  background: rgba(18, 183, 106, 0.12);
}

.comment-badge.lv3,
.score-num.lv3 {
  color: #1F5EFF;
}

.comment-badge.lv3 {
  background: rgba(31, 94, 255, 0.1);
}

.comment-badge.lv2,
.score-num.lv2 {
  color: #D97706;
}

.comment-badge.lv2 {
  background: rgba(255, 138, 0, 0.12);
}

.comment-badge.lv1,
.score-num.lv1 {
  color: #F04438;
}

.comment-badge.lv1 {
  background: rgba(240, 68, 56, 0.1);
}

/* ============ 全对时的正向反馈 ============ */
.perfect-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.perfect-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

/* ============ 错题预览 ============ */
.wrong-item {
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F0F2F6;
}

.wrong-item:last-child {
  border-bottom: none;
}

.wrong-brief {
  font-size: 28rpx;
  line-height: 1.65;
  color: #374151;
  /* 题干可能包含全角括号和书名号，用 break-word 防止长串撑破布局 */
  word-break: break-word;
}

/* ============ 按钮 ============ */
.quick-btn {
  width: 100%;
  margin-bottom: 20rpx;
}

.quick-btn:last-child {
  margin-bottom: 0;
}

/* ============ 广告容器 ============ */
.ad-slot {
  margin-top: 24rpx;
  padding: 16rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  min-height: 100rpx;
}