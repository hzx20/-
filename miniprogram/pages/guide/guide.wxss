/* 使用说明页样式 */

.guide-hero {
  background: linear-gradient(135deg, #1F5EFF 0%, #4B8BFF 100%);
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  margin-bottom: 24rpx;
  color: #FFFFFF;
  text-align: center;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.hero-sub {
  font-size: 27rpx;
  opacity: 0.9;
  margin-bottom: 24rpx;
}

.hero-stat {
  font-size: 24rpx;
  opacity: 0.85;
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
  display: inline-block;
}

/* ============ 功能说明 ============ */
.func-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F0F2F6;
}

.func-item:last-child {
  border-bottom: none;
}

.func-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(31, 94, 255, 0.1);
  color: #1F5EFF;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.func-title {
  font-size: 29rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.func-desc {
  font-size: 26rpx;
  line-height: 1.75;
  color: #4B5563;
}

/* ============ 主观题答题方法 ============ */
.method-item {
  margin-bottom: 28rpx;
}

.method-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F5EFF;
  margin-bottom: 10rpx;
}

.method-desc {
  font-size: 26rpx;
  line-height: 1.8;
  color: #4B5563;
}

/* 答题示例：用浅色底衬托，和说明文字区分开 */
.method-example {
  background: #F7F9FC;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 8rpx 0 20rpx;
}

.method-example-title {
  font-size: 24rpx;
  color: #9AA1AE;
  margin-bottom: 16rpx;
}

.method-example-body {
  font-size: 26rpx;
  line-height: 1.9;
  color: #374151;
}

.method-note {
  background: rgba(31, 94, 255, 0.06);
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #1F5EFF;
}

/* ============ 题库覆盖 ============ */
.subject-row {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F0F2F6;
}

.subject-row:last-child {
  border-bottom: none;
}

.subject-name {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 6rpx;
}

/* ============ 免责说明 ============ */
.disclaimer {
  font-size: 24rpx;
  line-height: 1.9;
  color: #9AA1AE;
}

.disclaimer view {
  margin-bottom: 8rpx;
}