/* 我的页面样式 */

/* ============ 头像区 ============ */
.profile-card {
  display: flex;
  flex-direction: row;
  align-items: center;
}

/*
  文字头像。
  渐变底 + 白色字，不请求任何用户权限，个人主体也能用。
  border-radius 50% 是小程序的常用写法，表示圆形（也可以写 999rpx）。
*/
.profile-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1F5EFF 0%, #4B8BFF 100%);
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.profile-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

/* ============ 数据概览 ============ */
.overview-row {
  display: flex;
  flex-direction: row;
}

.overview-cell {
  /* 【为什么三等分】让三个数字等宽平分，视觉整齐 */
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.overview-num {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.3;
  font-family: 'DIN Alternate', -apple-system, sans-serif;
}

/* ============ 功能列表 ============ */
.menu-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #F0F2F6;
}

.menu-item:last-child {
  border-bottom: none;
}

/* 按压反馈：让用户确认"点到了" */
.menu-item:active {
  background: #F7F9FC;
}

.menu-label {
  font-size: 30rpx;
  color: #1A1D26;
}

.menu-value {
  font-size: 24rpx;
  color: #9AA1AE;
  margin-top: 4rpx;
}

/* 右箭头，纯装饰 */
.menu-arrow {
  font-size: 40rpx;
  color: #C8CEDA;
  margin-left: 20rpx;
}

/* ============ 关于区块 ============ */
.about-btn {
  width: 100%;
  margin-top: 24rpx;
}

/* ============ 云端状态提示 ============ */
/*
  用一个小圆点 + 一句话说明当前模式。
  放在页面最底部，样式做得轻，不抢其他内容的注意力。
*/
.cloud-tip {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  margin-bottom: 24rpx;
}

.cloud-tip.on {
  background: rgba(18, 183, 106, 0.08);
  color: #12B76A;
}

.cloud-tip.off {
  background: rgba(154, 161, 174, 0.12);
  color: #6B7280;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.cloud-tip.on .dot {
  background: #12B76A;
}

.cloud-tip.off .dot {
  background: #9AA1AE;
}