/**
 * app.wxss —— 全局样式表
 *
 * 【小白解释】这里定义的是"设计规范"，全站共用。
 * 相当于给整个小程序定一套统一的字号、颜色、圆角，
 * 好处是每个页面都不用重复想样式，看起来也整齐。
 *
 * 【注意】小程序不支持 :root 和 CSS 变量，所以颜色直接写死。
 * 如果想改主色，需要用编辑器的"查找替换"批量改 #1F5EFF。
 */

page {
  /* 主色：微信生态里蓝色代表学习/工具类，可信、稳重 */
  background: #F4F6FB;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: #1A1D26;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* ========== 布局容器 ========== */
.container {
  padding: 24rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.row-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.col {
  display: flex;
  flex-direction: column;
}

.flex-1 {
  flex: 1;
}

/* ========== 卡片 ========== */
.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  /* 用极淡的阴影代替描边，比画边框更柔和 */
  box-shadow: 0 2rpx 16rpx rgba(31, 94, 255, 0.06);
}

/* ========== 文字层级 ========== */
.title-lg {
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
}

.subtitle {
  font-size: 26rpx;
  color: #6B7280;
}

/* 辅助文字：更浅，用于说明性内容 */
.text-muted {
  font-size: 24rpx;
  color: #9AA1AE;
}

/* 主色文字 */
.text-primary {
  color: #1F5EFF;
}

/* 正确/错误色，绿对红错 */
.text-success {
  color: #12B76A;
}

.text-danger {
  color: #F04438;
}

/* 数字强调 */
.num {
  font-family: 'DIN Alternate', -apple-system, sans-serif;
  font-weight: 700;
}

/* ========== 按钮 ========== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  line-height: 1;
}

.btn::after {
  border: none;
}

/* 主按钮 */
.btn-primary {
  background: #1F5EFF;
  color: #FFFFFF;
}

.btn-primary:active {
  background: #1A4FD6;
}

/* 次要按钮（描边） */
.btn-ghost {
  background: #FFFFFF;
  color: #1F5EFF;
  border: 2rpx solid #1F5EFF;
}

/* 灰色按钮 */
.btn-plain {
  background: #EEF1F7;
  color: #4B5563;
}

.btn-disabled {
  background: #D6DBE5;
  color: #98A0AE;
}

/* ========== 标签 ========== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

.tag-blue {
  background: rgba(31, 94, 255, 0.1);
  color: #1F5EFF;
}

.tag-orange {
  background: rgba(255, 138, 0, 0.12);
  color: #D97706;
}

.tag-green {
  background: rgba(18, 183, 106, 0.12);
  color: #12B76A;
}

.tag-gray {
  background: #EEF1F7;
  color: #6B7280;
}

/* ========== 进度条 ========== */
.progress-bar {
  height: 12rpx;
  background: #E8ECF3;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: linear-gradient(90deg, #1F5EFF, #4B8BFF);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* ========== 分隔线 ========== */
.divider {
  height: 2rpx;
  background: #F0F2F6;
  margin: 24rpx 0;
}

/* ========== 空状态 ========== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.35;
}

.empty-text {
  font-size: 28rpx;
  color: #9AA1AE;
  text-align: center;
}

/* ========== 底部固定操作条 ========== */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

/* 给固定底栏留出空间，避免内容被遮挡 */
.footer-space {
  height: 140rpx;
}